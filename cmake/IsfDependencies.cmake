set(VVGL_SOURCES GLBuffer GLBufferPool GLCachedProperty GLContext GLScene GLTexToTexCopier VVGL_Geom VVGL_StringUtils)
set(ISF_SOURCES ISFAttr ISFDoc ISFPassTarget ISFScene ISFVal VVISF_Base VVISF_StringUtils)
set(ISF_RUNTIME_SOURCES)
foreach(name IN LISTS VVGL_SOURCES)
    list(APPEND ISF_RUNTIME_SOURCES ${vvisf_SOURCE_DIR}/VVGL/src/${name}.cpp)
endforeach()
foreach(name IN LISTS ISF_SOURCES)
    list(APPEND ISF_RUNTIME_SOURCES ${vvisf_SOURCE_DIR}/VVISF/src/${name}.cpp)
endforeach()
if(APPLE)
    enable_language(OBJCXX)
    list(APPEND ISF_RUNTIME_SOURCES ${vvisf_SOURCE_DIR}/VVGL/src/GLBufferPool_CocoaAdditions.mm ${vvisf_SOURCE_DIR}/VVISF/src/VVISF_Base.mm)
    find_package(OpenGL REQUIRED)
    set(ISF_LIBS OpenGL::GL "-framework Cocoa" "-framework IOSurface" "-framework CoreVideo" "-framework CoreMedia")
    set(ISF_DEFS VVGL_SDK_MAC)
else()
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(ISF_EGL REQUIRED IMPORTED_TARGET egl glesv2)
    set(ISF_LIBS PkgConfig::ISF_EGL)
    set(ISF_DEFS VVGL_SDK_RPI SIDESHOW_GLES)
endif()
find_package(Git REQUIRED)
foreach(ISF_PATCH_NAME 0001-modern-context-build.patch 0002-validated-assets-budget.patch)
set(ISF_CONTEXT_PATCH "${CMAKE_CURRENT_LIST_DIR}/../third_party/isf/patches/${ISF_PATCH_NAME}")
execute_process(COMMAND ${GIT_EXECUTABLE} apply --reverse --check ${ISF_CONTEXT_PATCH}
    WORKING_DIRECTORY ${vvisf_SOURCE_DIR} RESULT_VARIABLE ISF_PATCH_PRESENT OUTPUT_QUIET ERROR_QUIET)
if(NOT ISF_PATCH_PRESENT EQUAL 0)
    execute_process(COMMAND ${GIT_EXECUTABLE} apply ${ISF_CONTEXT_PATCH}
        WORKING_DIRECTORY ${vvisf_SOURCE_DIR} COMMAND_ERROR_IS_FATAL ANY)
endif()
endforeach()
add_library(sideshow_isf_vendor STATIC ${ISF_RUNTIME_SOURCES})
target_include_directories(sideshow_isf_vendor SYSTEM PUBLIC ${vvisf_SOURCE_DIR}/VVGL/include ${vvisf_SOURCE_DIR}/VVISF/include)
target_compile_definitions(sideshow_isf_vendor PUBLIC ${ISF_DEFS})
target_link_libraries(sideshow_isf_vendor PUBLIC ${ISF_LIBS})
add_library(sideshow_isf_context STATIC src/isf_context.cpp)
target_include_directories(sideshow_isf_context PUBLIC src)
target_link_libraries(sideshow_isf_context PUBLIC sideshow_isf_vendor)
